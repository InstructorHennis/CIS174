@model CIS174FinalProject.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<div class="container">
    <h2>Delete Book</h2>
    
    <div class="alert alert-warning" role="alert">
        <h4>Are you sure you want to delete this book?</h4>
    </div>
    
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">@Model.Title</h5>
            <p class="card-text">
                <strong>Author:</strong> @Model.Author?.FirstName @Model.Author?.LastName<br />
                <strong>Genre:</strong> @Model.Genre?.Description<br />
                <strong>Year:</strong> @Model.Year<br />
                <strong>ISBN:</strong> @Model.ISBN
            </p>
        </div>
    </div>
    
    <form asp-action="Delete" method="post" class="mt-3">
        <input type="hidden" asp-for="ISBN" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
