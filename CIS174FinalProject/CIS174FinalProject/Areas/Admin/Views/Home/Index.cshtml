@{
    ViewData["Title"] = "Admin - Library Books";
}

<div class="container">
    <h1 class="mb-4">Admin - Library Books</h1>
    
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Book Title</th>
                <th>Author</th>
                <th>Genre</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (ViewBag.Books != null && ((IEnumerable<CIS174FinalProject.Models.Book>)ViewBag.Books).Any())
            {
                @foreach (var book in (IEnumerable<CIS174FinalProject.Models.Book>)ViewBag.Books)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.Author?.FirstName @book.Author?.LastName</td>
                        <td>@book.Genre?.Description</td>
                        <td>
                            <a asp-controller="Book" asp-action="Edit" asp-route-id="@book.ISBN" asp-area="" class="btn btn-sm btn-primary">Edit</a>
                            <a asp-controller="Home" asp-action="Delete" asp-route-id="@book.ISBN" asp-area="Admin" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">No books available</td>
                </tr>
            }
        </tbody>
    </table>
    
    <div class="mt-3">
        <a asp-controller="Book" asp-action="Create" asp-area="" class="btn btn-success">Add Book</a>
    </div>
</div>
